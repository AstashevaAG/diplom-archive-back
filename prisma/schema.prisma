generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  STUDENT
  GRADUATE
  SUPERVISOR
  ADMIN
}

enum WorkStatus {
  DRAFT
  TOPIC_SELECTED
  APPROVED
  IN_PROGRESS
  REVIEW
  DEFENSE
  PUBLISHED
  ARCHIVED
}

enum FileType {
  PDF
  PRESENTATION
  VIDEO
  OTHER
}

enum TopicRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PortfolioItemType {
  COURSEWORK
  PERSONAL_PROJECT
  RESEARCH_PAPER
  OTHER
}

enum TopicResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  role           Role      @default(STUDENT)
  group          String?
  specialization String?
  bio            String?
  avatarUrl      String?
  isApproved     Boolean   @default(true)
  isBlocked      Boolean   @default(false)
  failedLogins   Int       @default(0)
  blockedUntil   DateTime?
  refreshToken   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  worksAsAuthor              Work[]                @relation("WorkAuthor")
  worksAsSupervisor          Work[]                @relation("WorkSupervisor")
  reviews                    Review[]
  comments                   Comment[]
  topicRequests              TopicRequest[]        @relation("TopicStudent")
  topicRequestsAsSupervisor  TopicRequest[]        @relation("TopicSupervisor")
  notifications              Notification[]
  portfolioItems             StudentPortfolioItem[] @relation("StudentPortfolio")
  workMessages               WorkMessage[]         @relation("WorkMessages")
  topicResponseMessages      TopicResponseMessage[] @relation("TopicResponseMessages")
  supervisorTopics           SupervisorTopic[]     @relation("SupervisorTopics")
  topicResponses             TopicResponse[]       @relation("StudentTopicResponses")
  infoPosts                  InfoPost[]            @relation("InfoPostAuthor")

  @@map("users")
}

model Work {
  id           String     @id @default(uuid())
  title        String
  description  String?    @db.Text
  annotation   String?    @db.Text
  fullText     String?    @db.Text
  category     String?
  tags         String[]
  status       WorkStatus @default(DRAFT)
  year         Int?
  commissionReviewScore Float? @map("supervisorReviewScore")
  externalReviewScore    Float?
  viewCount    Int        @default(0)
  isPublic     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  authorId     String
  author       User       @relation("WorkAuthor", fields: [authorId], references: [id])
  supervisorId String?
  supervisor   User?      @relation("WorkSupervisor", fields: [supervisorId], references: [id])

  files    File[]
  reviews  Review[]
  comments Comment[]
  stages   WorkStage[]
  messages WorkMessage[]

  @@map("works")
}

model File {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  type         FileType
  url          String
  version      Int      @default(1)
  comment      String?  @db.Text
  textContent  String?  @db.Text
  createdAt    DateTime @default(now())

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  messages WorkMessage[]

  @@map("files")
}

model Review {
  id          String  @id @default(uuid())
  criteria    Json
  weights     Json
  totalScore  Float
  comment     String? @db.Text
  isFinalized Boolean @default(false)
  isCommissionReview Boolean @default(false) @map("isSupervisorReview")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])
  workId     String
  work       Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Comment {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  workId   String
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model TopicRequest {
  id            String             @id @default(uuid())
  proposedTopic String
  justification String?            @db.Text
  rejectReason  String?            @db.Text
  status        TopicRequestStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  studentId    String
  student      User   @relation("TopicStudent", fields: [studentId], references: [id])
  supervisorId String
  supervisor   User   @relation("TopicSupervisor", fields: [supervisorId], references: [id])

  @@map("topic_requests")
}

model WorkStage {
  id          String    @id @default(uuid())
  name        String
  deadline    DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@map("work_stages")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model ReviewCriteriaConfig {
  id          String  @id @default(uuid())
  name        String
  description String?
  weight      Float   @default(1.0)
  maxScore    Int     @default(10)
  isActive    Boolean @default(true)
  orderIndex  Int     @default(0)

  @@map("review_criteria_config")
}

model StudentPortfolioItem {
  id          String            @id @default(uuid())
  title       String
  type        PortfolioItemType
  description String?           @db.Text
  year        Int?
  grade       String?
  fileUrl     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  studentId String
  student   User   @relation("StudentPortfolio", fields: [studentId], references: [id])

  @@map("student_portfolio_items")
}

model WorkMessage {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation("WorkMessages", fields: [authorId], references: [id])
  workId   String
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  fileId   String?
  file     File?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@map("work_messages")
}

model SupervisorTopic {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  area        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supervisorId String
  supervisor   User            @relation("SupervisorTopics", fields: [supervisorId], references: [id])
  responses    TopicResponse[]

  @@map("supervisor_topics")
}

model InfoPost {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation("InfoPostAuthor", fields: [authorId], references: [id])

  @@map("info_posts")
}

model TopicResponse {
  id        String              @id @default(uuid())
  message   String?             @db.Text
  status    TopicResponseStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  studentId String
  student   User            @relation("StudentTopicResponses", fields: [studentId], references: [id])
  topicId   String
  topic     SupervisorTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  messages TopicResponseMessage[]

  @@unique([studentId, topicId])
  @@map("topic_responses")
}

model TopicResponseMessage {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  authorId String
  author   User          @relation("TopicResponseMessages", fields: [authorId], references: [id])
  responseId String
  response TopicResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("topic_response_messages")
}
